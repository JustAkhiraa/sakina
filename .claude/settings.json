{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/scripts/hook_check.py\"; [ -f \"$f\" ] && PYTHONIOENCODING=utf-8 python \"$f\" || true",
            "timeout": 60,
            "statusMessage": "Vérification du projet…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/scripts/hook_branch.py\"; [ -f \"$f\" ] && python \"$f\" || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
